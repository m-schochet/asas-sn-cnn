<INFO name="QUERY" value="SELECT dr2_source_id, dr3_source_id
FROM gaiadr3.dr2_neighbourhood AS gaia
JOIN user_mschoche.allgaia AS user
ON gaia.dr2_source_id = user.gaia_id"><![CDATA[SELECT dr2_source_id, dr3_source_id
FROM gaiadr3.dr2_neighbourhood AS gaia
JOIN user_mschoche.allgaia AS user
ON gaia.dr2_source_id = user.gaia_id]]></INFO>
